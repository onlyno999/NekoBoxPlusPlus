<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <Button
        android:id="@+id/reset_settings"
        style="@style/Widget.AppCompat.Button.Colored"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/reset_settings"
        android:textColor="?whiteOrTextPrimary" />

    <CheckBox
        android:id="@+id/backup_configurations"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="true"
        android:text="@string/backup_groups_and_configurations"
        android:textAppearance="?attr/textAppearanceSubtitle2" />

    <CheckBox
        android:id="@+id/backup_rules"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="true"
        android:text="@string/backup_rules"
        android:textAppearance="?attr/textAppearanceSubtitle2" />


    <CheckBox
        android:id="@+id/backup_settings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="true"
        android:text="@string/backup_settings"
        android:textAppearance="?attr/textAppearanceSubtitle2" />

    <Button
        android:id="@+id/action_export"
        style="@style/Widget.AppCompat.Button.Colored"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/action_export"
        android:textColor="?whiteOrTextPrimary" />

    <Button
        android:id="@+id/action_share"
        style="@style/Widget.AppCompat.Button.Colored"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/share"
        android:textColor="?whiteOrTextPrimary" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/backup_summary"
        android:textColor="?android:textColorTertiary" />

    <Button
        android:id="@+id/action_import_file"
        style="@style/Widget.AppCompat.Button.Colored"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/action_import_file"
        android:textColor="?whiteOrTextPrimary" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="WebDAV 备份"
        android:textAppearance="?attr/textAppearanceSubtitle2" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="填服务器上备份文件的完整地址（以 / 结尾时自动补文件名 nekoboxpp_backup.json）"
        android:textColor="?android:textColorTertiary" />

    <EditText
        android:id="@+id/webdav_url"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="https://dav.example.com/backup/"
        android:inputType="textUri"
        android:singleLine="true" />

    <EditText
        android:id="@+id/webdav_user"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="账号"
        android:inputType="text"
        android:singleLine="true" />

    <EditText
        android:id="@+id/webdav_pass"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="密码"
        android:inputType="textPassword"
        android:singleLine="true" />

    <Button
        android:id="@+id/action_webdav_upload"
        style="@style/Widget.AppCompat.Button.Colored"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="上传备份到 WebDAV"
        android:textColor="?whiteOrTextPrimary" />

    <Button
        android:id="@+id/action_webdav_download"
        style="@style/Widget.AppCompat.Button.Colored"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="从 WebDAV 下载并导入"
        android:textColor="?whiteOrTextPrimary" />

</LinearLayout>

</ScrollView>