e2a\uff1a\u70b9\u4eae\u65b0\u7684\uff0c\u65e7\u7684\u81ea\u52a8\u7184\u706d</li> <li>\u81ea\u52a8\u6a21\u5f0f\u5f00\u7740\u7684\u65f6\u5019\uff0c\u4e0d\u80fd\u624b\u52a8\u70b9\u9009\u4efb\u4f55\u8282\u70b9\uff1b\u60f3\u624b\u52a8\u9009\uff0c\u5148\u628a\u81ea\u52a8\u5173\u6389</li> <li>\u65ad\u5f00\u91cd\u8fde\u65f6\uff0c\u4e5f\u4f1a\u81ea\u52a8\u56de\u5230\u6c60\u5b50\u91cc\u8bb0\u5f55\u6700\u5feb\u7684\u8282\u70b9</li> </ul>"},{"location":"guide/#_3","title":"\u5907\u7528\u8f6e\u6362\u4e0e\u65ad\u7ebf\u81ea\u6362","text":"<p>\u81ea\u52a8\u6a21\u5f0f\u70b9\u4eae\u540e\uff0c\u8f6f\u4ef6\u4f1a\u5728\u540e\u53f0\u7167\u770b\u8fd9\u4e2a\u6c60\u5b50\uff1a</p> <ul> <li>\u6bcf 5 \u5206\u949f\u8f6e\u6362\u6d4b\u6c60\u5b50\u91cc\u7684 5 \u4e2a\u8282\u70b9\uff08\u53ea\u8bb0\u8bb0\u5f55\uff0c\u4e0d\u6362\u6b63\u5728\u7528\u7684\uff09</li> <li>\u6b63\u5728\u7528\u7684\u8282\u70b9\u5982\u679c\u771f\u8fde\u63a5\u63e1\u624b\u8fde\u7eed\u5931\u8d25\uff08\u8282\u70b9\u88ab\u6390\u3001\u5230\u671f\u3001\u4e0b\u7ebf\uff09\uff0c\u5927\u7ea6 10 \u79d2\u5185\u81ea\u52a8\u6362\u5230\u8bb0\u5f55\u91cc\u6700\u5feb\u7684\u5907\u9009\uff0c\u4e0d\u7528\u624b\u52a8\u5e72\u9884</li> <li>\u7f51\u9875\u6253\u4e0d\u5f00\u4f46\u8282\u70b9\u672c\u8eab\u6ca1\u6b7b\uff08\u6bd4\u5982\u76ee\u6807\u7f51\u7ad9\u7684\u95ee\u9898\uff09\uff0c\u4e0d\u4f1a\u8bef\u5224\u6362\u8282\u70b9</li> </ul>"},{"location":"guide/#_4","title":"\u8ba2\u9605\u66f4\u65b0","text":"<ul> <li>\u8ba2\u9605\u66f4\u65b0\u62c9\u5230\u65b0\u8282\u70b9\u540e\uff0c\u8f6f\u4ef6\u53ea\u6d4b\u65b0\u6765\u7684\u8282\u70b9\uff08\u5730\u533a\uff0b\u5ef6\u8fdf\uff0c\u5341\u4e2a\u4e00\u6279\uff09\uff0c\u6d4b\u597d\u81ea\u52a8\u5f52\u4f4d\u5230\u5bf9\u5e94\u5206\u533a</li> <li>\u8001\u8282\u70b9\u7684\u8bb0\u5f55\u6309\u8282\u70b9\u672c\u8eab\u4fdd\u5b58\uff0c\u4e0d\u4f1a\u56e0\u4e3a\u66f4\u65b0\u88ab\u6e05\u6389</li> <li>\u5982\u679c\u66f4\u65b0\u628a\u6b63\u5728\u7528\u7684\u8282\u70b9\u66ff\u6389\u4e86\uff0c\u8f6f\u4ef6\u4f1a\u81ea\u52a8\u8865\u9009\u540c\u7ec4\u6700\u5feb\u7684\u9876\u4e0a\uff0c\u8fde\u63a5\u4e0d\u65ad\u6863</li> </ul>"},{"location":"guide/#_5","title":"\u5206\u6d41\uff08\u8def\u7531\u89c4\u5219\u7ed1\u6c60\uff09","text":"<p>\u8def\u7531\u8bbe\u7f6e\u91cc\uff0c\u6bcf\u6761\u89c4\u5219\u7684\u51fa\u53e3\u9664\u4e86\u300c\u4ee3\u7406 / \u7ed5\u8fc7 / \u5c4f\u853d / \u9009\u62e9\u914d\u7f6e\u300d\uff0c\u9009\u914d\u7f6e\u540e\u8fd8\u53ef\u4ee5\uff1a</p> <ul> <li>\u70b9\u67d0\u4e2a\u5177\u4f53\u8282\u70b9\uff1a\u8fd9\u6761\u89c4\u5219\u56fa\u5b9a\u8d70\u5b83</li> <li>\u70b9\u67d0\u4e2a\u5206\u533a\u7684\u300c\u81ea\u52a8\u300d\uff1a\u8fd9\u6761\u89c4\u5219\u7ed1\u8fd9\u4e2a\uff08\u5206\u7ec4\uff0b\u56fd\u5bb6\uff09\u7684\u8282\u70b9\u6c60\uff0c\u6c60\u5185\u81ea\u52a8\u9009\u6700\u5feb\u7684</li> </ul> <p>\u6bcf\u6761\u89c4\u5219\u53ef\u4ee5\u7ed1\u4e0d\u540c\u7684\u6c60\uff0c\u4e92\u4e0d\u5f71\u54cd\uff1b\u7ed1\u7684\u6c60\u548c\u524d\u7aef\u662f\u5426\u70b9\u4eae\u65e0\u5173\uff0c\u6ca1\u70b9\u4eae\u4e5f\u80fd\u8d70\u3002</p>"},{"location":"guide/#_6","title":"\u5220\u9664\u8282\u70b9","text":"<ul> <li>\u70b9\u5783\u573e\u6876\u5220\u9664\u8282\u70b9\u540e\u6709\u51e0\u79d2\u53ef\u4ee5\u70b9\u300c\u8fd8\u539f\u300d\u64a4\u9500</li> <li>\u5220\u6389\u7684\u5982\u679c\u6b63\u662f\u5728\u7528\u7684\u8282\u70b9\uff0c\u8f6f\u4ef6\u5f53\u573a\u81ea\u52a8\u8865\u9009\u540c\u7ec4\u6700\u5feb\u7684\uff0c\u4e0d\u7528\u7b49</li> </ul>"},{"location":"guide/#webdav","title":"WebDAV \u5907\u4efd","text":"<p>\u300c\u8bbe\u7f6e \u2192 \u5907\u4efd\u300d\u91cc\u53ef\u4ee5\u628a\u914d\u7f6e\u5907\u4efd\u5230 WebDAV\uff08\u6bd4\u5982\u575a\u679c\u4e91\uff09\uff1a</p> <ul> <li>\u5730\u5740\u586b\u575a\u679c\u4e91\u7684 <code>https://dav.jianguoyun.com/dav/</code>\uff0c\u8f6f\u4ef6\u4f1a\u81ea\u52a8\u843d\u5230\u5b50\u6587\u4ef6\u5939\u91cc</li> <li>\u5f00\u7740 VPN \u4e5f\u80fd\u5907\u4efd\uff0c\u5907\u4efd\u6d41\u91cf\u81ea\u52a8\u8d70\u76f4\u8fde</li> </ul>"},{"location":"nb4a-plugin/","title":"\u63d2\u4ef6","text":"<p>\u67d0\u4e9b\u534f\u8bae\uff08\u6bd4\u5982\u4e00\u4e9b\u63d2\u4ef6\u578b\u51fa\u7ad9\uff09\u5728\u8fd0\u884c\u65f6\u9700\u8981\u989d\u5916\u7684\u63d2\u4ef6\u7a0b\u5e8f\u3002\u8fde\u63a5\u65f6\u5982\u679c\u63d0\u793a\u7f3a\u5c11\u63d2\u4ef6\uff0c\u6309\u5f39\u7a97\u91cc\u7684\u300c\u4e0b\u8f7d\u300d\u83b7\u53d6\uff0c\u6216\u5230\u4e0b\u9762\u5730\u5740\u627e\u5bf9\u5e94\u63d2\u4ef6\uff1a</p> <ul> <li>NekoBox++ \u53d1\u5e03\u9875</li> </ul> <p>\u5b89\u88c5\u63d2\u4ef6\u540e\u56de\u5230\u8f6f\u4ef6\u91cd\u65b0\u8fde\u63a5\u5373\u53ef\u3002\u63d2\u4ef6\u4e0e\u4e3b\u7a0b\u5e8f\u662f\u72ec\u7acb\u7684\u5b89\u88c5\u5305\uff0c\u4e92\u4e0d\u5f71\u54cd\u5347\u7ea7\u3002</p>"},{"location":"nb4a-route/","title":"\u8def\u7531","text":"<p>\u8def\u7531\u51b3\u5b9a\u54ea\u4e9b\u6d41\u91cf\u8d70\u4ee3\u7406\u3001\u54ea\u4e9b\u76f4\u8fde\u3001\u54ea\u4e9b\u5c4f\u853d\u3002\u5728\u300c\u8def\u7531\u300d\u9875\u9762\u7ba1\u7406\u89c4\u5219\uff0c\u81ea\u4e0a\u800c\u4e0b\u4f9d\u6b21\u5339\u914d\u3002</p>"},{"location":"nb4a-route/#_2","title":"\u5e38\u7528\u8bbe\u7f6e","text":"<ul> <li>\u51fa\u53e3\uff1a\u4ee3\u7406\uff08\u8d70\u5f53\u524d\u8fde\u63a5\uff09\u3001\u7ed5\u8fc7\uff08\u76f4\u8fde\uff09\u3001\u5c4f\u853d\uff08\u62e6\u622a\uff09</li> <li>\u6761\u4ef6\uff1a\u57df\u540d\u3001\u57df\u540d\u540e\u7f00\u3001IP \u6bb5\u3001GeoIP / GeoSite \u5206\u7c7b\u7b49</li> </ul>"},{"location":"nb4a-route/#nekobox","title":"\u5206\u6d41\u7ed1\u6c60\uff08NekoBox++ \u7279\u6027\uff09","text":"<p>\u51fa\u53e3\u9009\u300c\u9009\u62e9\u914d\u7f6e\u300d\u540e\uff0c\u53ef\u4ee5\u628a\u8fd9\u6761\u89c4\u5219\u7ed1\u5230\uff1a</p> <ul> <li>\u67d0\u4e2a\u5177\u4f53\u8282\u70b9\uff0c\u6216</li> <li>\u67d0\u4e2a\uff08\u5206\u7ec4\uff0b\u56fd\u5bb6\uff09\u7684\u8282\u70b9\u6c60\uff08\u70b9\u5206\u533a\u7684\u300c\u81ea\u52a8\u300d\uff09</li> </ul> <p>\u7ed1\u6c60\u540e\u8fd9\u6761\u89c4\u5219\u7684\u6d41\u91cf\u5728\u6c60\u5185\u81ea\u52a8\u9009\u6700\u5feb\u7684\u8282\u70b9\uff0c\u548c\u4e3b\u8fde\u63a5\u8d70\u54ea\u6761\u4e92\u4e0d\u5f71\u54cd\u3002\u6bcf\u6761\u89c4\u5219\u53ef\u4ee5\u7ed1\u4e0d\u540c\u7684\u6c60\u3002</p>"},{"location":"nb4a-route/#play","title":"\u8c37\u6b4c Play \u5546\u5e97\u4e0b\u8f7d\u89c4\u5219\uff08\u4e2d\u56fd\u89c4\u5219\u5fc5\u52a0\uff09","text":"<p>\u5f00\u4e86\u300c\u4e2d\u56fd\u57df\u540d / \u4e2d\u56fd IP \u76f4\u8fde\u300d\u8fd9\u7c7b\u89c4\u5219\u540e\uff0cPlay \u5546\u5e97\u4f1a\u65e0\u6cd5\u4e0b\u8f7d\u3001\u6216\u4e0b\u8f7d\u5230 99% \u5361\u4f4f\u4e0d\u52a8\u2014\u2014\u5546\u5e97\u7528\u7684\u51e0\u4e2a\u8c37\u6b4c\u57df\u540d\u88ab\u5224\u6210\u4e86\u76f4\u8fde\u3002</p> <p>\u89e3\u51b3\u529e\u6cd5\uff1a\u81ea\u5df1\u52a0\u4e00\u6761\u89c4\u5219\uff0c\u628a\u4e0b\u9762\u8fd9\u4e9b\u57df\u540d\u6307\u5230\u4ee3\u7406\uff0c\u5e76\u628a\u8fd9\u6761\u89c4\u5219\u653e\u5728\u4e2d\u56fd\u89c4\u5219\u524d\u9762\uff1a</p> <ul> <li>\u7c7b\u578b\uff1a<code>domain</code>\uff08\u57df\u540d\uff09</li> <li>\u5185\u5bb9\uff08\u6574\u6bb5\u590d\u5236\u7c98\u8d34\uff09\uff1a</li> </ul> <pre><code>googleapis.com,connectivitycheck.gstatic.com,www.google.com,play-fe.googleapis.com,play-lh.googleusercontent.com,playstoregatewayadapter-pa.googleapis.com,services.googleapis.cn,xn--ngstr-lra8j.com,play.googleapis.com,mtalk.google.com\n</code></pre> <ul> <li>\u51fa\u53e3\uff1a\u4ee3\u7406\uff08\u4e5f\u53ef\u4ee5\u7ed1\u4e00\u4e2a\u8282\u70b9\u6c60\uff09</li> </ul> <p>\u52a0\u5b8c\u91cd\u8fde\u4e00\u6b21\uff0c\u5546\u5e97\u5c31\u80fd\u6b63\u5e38\u4e0b\u8f7d\u4e86\u3002\u4e0d\u52a0\u8fd9\u6761\u3001\u53c8\u5f00\u7740\u4e2d\u56fd\u57df\u540d/\u4e2d\u56fd IP \u89c4\u5219\u7684\u8bdd\uff0c\u5546\u5e97\u5c31\u662f\u4e0b\u4e0d\u4e86\u3002</p> <p>\u6ce8\uff1a1.4.6 \u8d77\u8fd9\u4e09\u6761\u89c4\u5219\u5df2\u7ecf\u5185\u7f6e\u5728 App \u91cc\u3001\u9ed8\u8ba4\u5f00\u542f\uff08\u8def\u7531\u9875\u53ef\u89c1\uff09\uff0c\u4e0d\u7528\u518d\u624b\u52a8\u6dfb\u52a0\u3002</p>"}]}